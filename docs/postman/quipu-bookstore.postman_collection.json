            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Homage to Catalonia\",\n  \"subTitle\": \"A Memoir\",\n  \"authorId\": {{authorId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update created book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{createdBookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books",
                "{{createdBookId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Homage to Catalonia\",\n  \"subTitle\": null,\n  \"authorId\": {{authorId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get updated book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const book = pm.response.json();",
                  "pm.test(\"Returns the updated book\", () => {",
                  "    pm.expect(String(book.bookId)).to.eql(String(pm.variables.get(\"createdBookId\")));",
                  "    pm.expect(book.title).to.eql(\"Homage to Catalonia\");",
                  "    pm.expect(String(book.author.authorId)).to.eql(String(pm.variables.get(\"authorId\")));",
                  "});",
                  "pm.test(\"Update took effect: subTitle cleared to null\", () => pm.expect(book.subTitle).to.be.null);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{createdBookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books",
                "{{createdBookId}}"
              ]
            }
          }
        },
        {
          "name": "Delete created book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{createdBookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books",
                "{{createdBookId}}"
              ]
            }
          }
        },
        {
          "name": "Get deleted book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"errorCode is BOOK_NOT_FOUND\", () => pm.expect(pm.response.json().errorCode).to.eql(\"BOOK_NOT_FOUND\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{createdBookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books",
                "{{createdBookId}}"
              ]
            }
          }
        }
      ]
