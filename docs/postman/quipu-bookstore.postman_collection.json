{
  "info": {
    "name": "Quipu Bookstore API",
    "description": "Manual test collection for the Quipu Bookstore API running locally (Docker or dotnet run).\n\nSet `crudClientSecret` (Current value only) before running. Search requests need `readAccessToken`, obtained through the implicit flow. See docs/postman/README.md. No credentials are stored in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5107"
    },
    {
      "key": "crudClientId",
      "value": "bookstore-crud-client"
    },
    {
      "key": "crudClientSecret",
      "value": "crud123!",
      "description": "Local assessment-only mock value (matches appsettings.Development.json / .env.example). Not a real secret. If you override DevelopmentAuth:CrudClientSecret locally, replace this Current value with yours."
    },
    {
      "key": "readClientId",
      "value": "bookstore-swagger-client"
    },
    {
      "key": "scopeManage",
      "value": "books.manage"
    },
    {
      "key": "scopeRead",
      "value": "books.read"
    },
    {
      "key": "implicitRedirectUri",
      "value": "http://localhost:5107/swagger/oauth2-redirect.html"
    },
    {
      "key": "bookId",
      "value": "1",
      "description": "Placeholder: any existing book id."
    },
    {
      "key": "authorId",
      "value": "1",
      "description": "Placeholder: any existing author id."
    },
    {
      "key": "missingBookId",
      "value": "999999"
    },
    {
      "key": "missingAuthorId",
      "value": "999999"
    },
    {
      "key": "accessToken",
      "value": "",
      "description": "Filled by 'Get CRUD token'."
    },
    {
      "key": "readAccessToken",
      "value": "",
      "description": "Paste the implicit-flow token here (see guide)."
    },
    {
      "key": "createdBookId",
      "value": "",
      "description": "Filled by 'Create book'."
    }
  ],
  "item": [
    {
      "name": "01 Basic access",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Swagger UI",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/swagger/index.html",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "swagger",
                "index.html"
              ]
            }
          }
        },
        {
          "name": "OpenAPI document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Documents /api/books\", () => pm.expect(pm.response.json().paths).to.have.property(\"/api/books\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/swagger/v1/swagger.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "swagger",
                "v1",
                "swagger.json"
              ]
            }
          }
        },
        {
          "name": "Search without token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books"
              ]
            }
          }
        },
        {
          "name": "Get book without token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books",
                "{{bookId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 Client credentials",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Get CRUD token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"crudClientSecret is set\", () => pm.expect(pm.variables.get(\"crudClientSecret\")).to.not.be.empty);",
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Bearer token returned\", () => pm.expect(body.token_type).to.eql(\"Bearer\"));",
                  "pm.collectionVariables.set(\"accessToken\", body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "{{crudClientId}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{crudClientSecret}}"
                },
                {
                  "key": "scope",
                  "value": "{{scopeManage}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/connect/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "connect",
                "token"
              ]
            }
          }
        },
        {
          "name": "Token with wrong secret",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"error is invalid_client\", () => pm.expect(pm.response.json().error).to.eql(\"invalid_client\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "{{crudClientId}}"
                },
                {
                  "key": "client_secret",
                  "value": "not-the-secret"
                },
                {
                  "key": "scope",
                  "value": "{{scopeManage}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/connect/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "connect",
                "token"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "03 CRUD (client credentials)",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{accessToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Get book by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has nested author\", () => pm.expect(pm.response.json().author).to.have.property(\"name\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books",
                "{{bookId}}"
              ]
            }
          }
        },
        {
          "name": "Create book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Location header\", () => pm.response.to.have.header(\"Location\"));",
                  "pm.collectionVariables.set(\"createdBookId\", pm.response.json().bookId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
