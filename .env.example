# Optional overrides for docker-compose.yml. Copy to .env only if you want different values.
# The values below are the local assessment-only mock defaults — not production credentials.
# .env is gitignored — never commit real secrets.

# SQL Server "sa" password used by the sqlserver container.
# Must satisfy SQL Server's complexity policy (8+ chars, upper+lower+digit+symbol).
# Only applied when the SQL Server volume is first created.
MSSQL_SA_PASSWORD=SqlDev12345!

MSSQL_DB_NAME=QuipuBookstore

# Password for the quipu-manager demo user on the implicit-flow sign-in page.
DEV_AUTH_PASSWORD=bookstore123

# OAuth2 client_credentials secret for bookstore-crud-client.
DEV_AUTH_CRUD_CLIENT_SECRET=crud123!

# Host ports. Change these if 5107 / 1433 are already in use on your machine.
API_HTTP_PORT=5107
SQLSERVER_HOST_PORT=1433
