    {
      "name": "05 Search (implicit flow)",
      "description": "Requires `readAccessToken`. Either use this folder's Authorization tab -> Get New Access Token (OAuth 2.0, Implicit), then copy the token into `readAccessToken`, or follow the browser steps in the guide.",
      "auth": {
        "type": "oauth2",
        "oauth2": [
          {
            "key": "accessToken",
            "value": "{{readAccessToken}}",
            "type": "string"
          },
          {
            "key": "addTokenTo",
            "value": "header",
            "type": "string"
          },
          {
            "key": "headerPrefix",
            "value": "Bearer",
            "type": "string"
          },
          {
            "key": "grant_type",
            "value": "implicit",
            "type": "string"
          },
          {
            "key": "authUrl",
            "value": "{{baseUrl}}/connect/authorize",
            "type": "string"
          },
          {
            "key": "redirect_uri",
            "value": "{{implicitRedirectUri}}",
            "type": "string"
          },
          {
            "key": "clientId",
            "value": "{{readClientId}}",
            "type": "string"
          },
          {
            "key": "scope",
            "value": "{{scopeRead}}",
            "type": "string"
          },
          {
            "key": "tokenName",
            "value": "quipu-books-read",
            "type": "string"
          },
          {
            "key": "useBrowser",
            "value": false,
            "type": "boolean"
          }
        ]
      },
